{
    "name": "rushing/laravel-popcorn",
    "description": "A tiny kernel for transport-agnostic invocable capabilities and self-validating strategy ladders — local, MCP, or webhook bindings behind one named contract.",
    "keywords": ["laravel", "invocable", "strategy", "capability", "registry", "binding"],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/php-popcorn": "dev-main",
        "symfony/finder": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\Popcorn\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\Popcorn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rushing\\Popcorn\\Laravel\\PopcornServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "analyse": "phpstan analyse",
        "test": "@php vendor/bin/pest"
    }
}
