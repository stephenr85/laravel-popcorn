<?php

namespace {{ namespace }};

use Rushing\Popcorn\Registries\BasicRegistry;
use Rushing\Popcorn\Registries\ForwardsToRegistryStore;
use Rushing\Popcorn\Registries\Gated;
use Rushing\Popcorn\Registries\IsRegistry;
use Rushing\Popcorn\Registries\OnKeyDuplicate;
use Rushing\Popcorn\Registries\PopulationRequirement;
use Rushing\Popcorn\Registries\Registry;
use Rushing\Popcorn\Registries\RegistryKey;

/**
 * The `{{ root }}` registry, generated by `popcorn:make:registry`.
 *
 * Say here what an entry is, who registers one and who reads them, and add a `description:` to the
 * declaration: it seeds the docs page and `popcorn:registries`. The duplicate policy is written as
 * `Supersede` because most of the estate means that; change it if this registry means `Reject` or `Admit`.
 *
 * Every read, and the host's authorizer, goes through ForwardsToRegistryStore to the held store. Add
 * your own methods here. One that reads `$this->entries->resolve()` needs a twin over `tryResolve()`, so a
 * caller holding a key from outside can miss without an exception.
 *
 * @implements Registry<mixed>
 */
#[IsRegistry(
    root: '{{ root }}',
    entryType: 'mixed',
    onKeyDuplicate: OnKeyDuplicate::Supersede,
    populationRequirement: PopulationRequirement::Optional,
)]
class {{ class }} implements Gated, Registry
{
    use ForwardsToRegistryStore;

    /** @var BasicRegistry<mixed> */
    private BasicRegistry $entries;

    public function __construct()
    {
        $this->entries = BasicRegistry::for($this);
    }

    public function register(RegistryKey|string $key, mixed $entry, ?string $by = null, ?string $ability = null): static
    {
        $this->entries->register($key, $entry, $by, $ability);

        return $this;
    }

    protected function store(): BasicRegistry
    {
        return $this->entries;
    }
}
